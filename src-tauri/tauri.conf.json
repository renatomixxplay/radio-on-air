{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio On Air",
  "version": "0.1.0",
  "identifier": "org.radioonair.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Radio On Air",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "backgroundColor": "#121419",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
